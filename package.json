{
  "name": "evm-nexus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @nexus/web dev",
    "build": "pnpm --filter @nexus/web build",
    "start": "pnpm --filter @nexus/web start",
    "worker": "pnpm --filter @nexus/worker start",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "contracts:build": "pnpm --filter @nexus/contracts build",
    "contracts:test": "pnpm --filter @nexus/contracts test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "@node-rs/argon2",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  },
  "dependencies": {
    "@nexus/config": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "prisma": "7.8.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
