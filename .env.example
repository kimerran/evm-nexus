# EVM Nexus environment (SPEC §11.2). Copy to `.env` and fill in secrets.
# `.env` is gitignored. Prisma 7 does NOT auto-load .env — it is loaded via
# prisma.config.ts and at app/worker bootstrap.

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=            # 32+ byte random; JWS signing (e.g. `openssl rand -base64 48`)
ENCRYPTION_KEY=            # 32-byte base64; app-layer AES for at-rest network secrets
CSRF_SECRET=              # 16+ byte random

# --- Database (docker compose postgres) ---
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/evm_nexus?schema=public
DIRECT_DATABASE_URL=      # for migrations if using a pooler (optional)

# --- Redis (docker compose redis) ---
REDIS_URL=redis://localhost:6379

# --- File storage ---
STORAGE_DRIVER=s3                 # volume | s3  (dev uses MinIO)
STORAGE_VOLUME_PATH=/data/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=evm-nexus
S3_ACCESS_KEY_ID=nexus
S3_SECRET_ACCESS_KEY=nexus-secret
S3_FORCE_PATH_STYLE=true

# --- Server-custodied signers (TEST CHAIN ONLY, worker-only) ---
FAUCET_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
PAYMASTER_SIGNER_PRIVATE_KEY=

# --- Seed admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                  # strong; rotate after first login

# --- Defaults for first network (used by seed; points at the anvil container) ---
DEFAULT_NETWORK_NAME=Anvil-Local
DEFAULT_CHAIN_ID=31337
DEFAULT_RPC_URL=http://localhost:8545
DEFAULT_EXPLORER_URL=
DEFAULT_NATIVE_SYMBOL=ETH

# --- Limits ---
FAUCET_DRIP_WEI=5000000000000000000
FAUCET_DAILY_CAP_WEI=500000000000000000000
BOMBARD_MAX_TPS=1000
BOMBARD_MAX_TOTAL=1000000
